// 공용 GPU 서버(metis, RTX 5090 1장)용 개발 컨테이너.
// 서버 계정마다 컨테이너가 따로 생긴다: layer-fusion-<서버 계정>.
// GPU는 한 장을 나눠 쓴다. 디버깅 실행은 동시에 가능, 본 실험은 인프라 담당 혼자 대기열로 (ADR 0009).
{
  "name": "layer-fusion (${localEnv:USER})",
  // Python 3.11 고정. 두 사람이 같은 이미지를 쓰도록 digest까지 고정한다 (2026-11-18 metis에서 받은 값).
  "image": "python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535",
  // 공용 서버(20코어, RAM 61GB)를 혼자 차지하지 않도록 컨테이너당 CPU 8코어·메모리 24GB 상한.
  // 메모리 상한을 넘으면 이 컨테이너 안의 프로세스만 종료되고 다른 사람 작업에는 영향이 없다.
  "runArgs": [
    "--name", "layer-fusion-${localEnv:USER}",
    "--gpus", "device=0",
    "--cpus=8",
    "--memory=24g",
    "--memory-swap=24g",
    "--shm-size=8g"
  ],
  // 모델 가중치는 각자 서버 홈에 보관 → 컨테이너를 다시 만들어도 다시 받지 않는다.
  "mounts": [
    "source=${localEnv:HOME}/.cache/huggingface,target=/root/.cache/huggingface,type=bind"
  ],
  // gcc + libc6-dev(stdlib.h 등 C 헤더): torch.compile(Triton)이 실행 중에 C 코드를 컴파일할 때 필요.
  // --no-install-recommends로는 libc6-dev가 따라오지 않으므로 명시한다. git: 컨테이너 안에서 pull/commit.
  "postCreateCommand": "apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev git && pip install -r requirements.lock && pip install -e . --no-deps",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
